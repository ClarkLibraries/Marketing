.ephemera-page .ep-example strong,
.ephemera-page .ep-callout strong,
.ephemera-page .ep-warning strong { font-weight: 900; }

.ephemera-page .ep-step {
  padding: 17px;
  border: 2px solid var(--ep-ink);
  border-radius: 11px;
