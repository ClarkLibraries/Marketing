.ephemera-page .ep-step strong {
  display: block;
  margin-bottom: 5px;
}

.ephemera-page .ep-table-wrap {
  width: 100%;
  overflow-x: auto;
  margin: 16px 0 22px;
  border: 2px solid var(--ep-ink);
  border-radius: 10px;
  background: #fff;
}

.ephemera-page table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
