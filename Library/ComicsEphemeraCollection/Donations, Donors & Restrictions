  font-weight: 900;
}

.ephemera-page tr:last-child td { border-bottom: 0; }

.ephemera-page .ep-links {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 16px;
}

.ephemera-page .ep-link {
  display: block;
  padding: 15px;
  border: 2px solid var(--ep-ink);
  border-radius: 10px;
  background: #fff;
  color: var(--ep-ink);
  text-decoration: none;
  box-shadow: 2px 2px 0 var(--ep-ink);
}

.ephemera-page .ep-link:hover {
  background: var(--ep-yellow);
  color: var(--ep-ink);
