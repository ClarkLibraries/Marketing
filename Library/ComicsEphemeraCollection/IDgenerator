  function html(level) {
    var h = "h" + level, s = "h" + Math.min(level + 1, 6);
    return [
      "<div class='w' lang='en' data-mode='light'>",
      "<header>",
      "  <" + h + " class='title'>Ephemera ID Generator</" + h + ">",
      "  <p class='lede'>Pick the item type, enter the next number, and copy the ID. Write it lightly in pencil on the sleeve and paste it into the inventory spreadsheet.</p>",
      "</header>",
      "<section class='card' aria-labelledby='h-item'>",
      "  <" + s + " class='sub' id='h-item'>Item</" + s + ">",
      "  <div class='row'>",
      "    <div class='field'>",
      "      <label for='type'>Item type</label>",
      "      <select id='type'></select>",
      "      <label class='choice' for='reserve'><input type='checkbox' id='reserve'><span>Show reserve types<small>Not in use yet. Turn on only after the librarian activates them.</small></span></label>",
      "    </div>",
      "    <div class='field'>",
      "      <label for='num'>Item number</label>",
      "      <input type='text' id='num' value='1' inputmode='numeric' pattern='[0-9]*' autocomplete='off' maxlength='5' aria-describedby='num-hint'>",
      "      <p class='hint' id='num-hint'>One running number for the whole collection: the last number in the spreadsheet plus one.</p>",
      "      <p class='error' id='error' hidden>Enter a whole number from 1 to 99999.</p>",
      "    </div>",
      "  </div>",
      "  <fieldset>",
      "    <legend>How is the word chosen?</legend>",
      "    <label class='choice'><input type='radio' name='mode' value='number' checked><span>From the number (recommended)<small>The same type and number always give the same ID, so a lost label can be rebuilt.</small></span></label>",
      "    <label class='choice'><input type='radio' name='mode' value='random'><span>Random<small>Picks any word from the type's family. Write it down, because it cannot be rebuilt from the number.</small></span></label>",
      "  </fieldset>",
      "</section>",
      "<section class='card' aria-labelledby='h-id'>",
      "  <" + s + " class='sub' id='h-id'>Your ID</" + s + ">",
      "  <div class='panel'>",
      "    <p class='id' id='idOut'></p>",
      "    <p class='meaning' id='meaning'></p>",
      "    <div class='actions'>",
      "      <button type='button' class='primary' id='copy'>Copy ID</button>",
      "      <button type='button' id='shuffle' hidden>Shuffle word</button>",
      "      <button type='button' id='next'>Next number</button>",
      "    </div>",
      "  </div>",
      "  <p class='status' id='status' role='status'></p>",
      "  <div role='status'><p class='notice' id='dupe' hidden></p></div>",
      "  <p class='vh' id='announce' role='status' aria-live='polite'></p>",
      "</section>",
      "<section class='card full' aria-labelledby='h-recent'>",
      "  <" + s + " class='sub' id='h-recent'>IDs copied this visit</" + s + ">",
      "  <ul class='list recent' id='recent'></ul>",
      "  <p class='empty' id='recentEmpty'>Nothing copied yet. This list resets when you close the page.</p>",
      "</section>",
      "<details>",
      "  <summary>Check against IDs already in the spreadsheet</summary>",
      "  <div class='inner'>",
      "    <p class='hint'>Paste the ID column from the spreadsheet. The tool finds the highest number used, warns if the current number is taken, and suggests the next free one. Nothing leaves this page.</p>",
      "    <div class='field'>",
      "      <label for='existing'>Existing IDs</label>",
      "      <textarea id='existing' placeholder='ST-0001-WHACK&#10;PC-0002-BOOM&#10;PO-0003-BAM'></textarea>",
      "    </div>",
      "    <p class='hint' id='checkOut' role='status'></p>",
      "    <div class='actions'><button type='button' class='small' id='useNext' disabled>Use next free number</button></div>",
      "  </div>",
      "</details>",
      "<details>",
      "  <summary>All item types and sound families</summary>",
      "  <div class='inner'>",
      "    <p class='hint'>Every family rhymes on one sound. Reserve types are ready to switch on when needed.</p>",
      "    <ul class='list' id='ref'></ul>",
      "  </div>",
      "</details>",
      "</div>"
    ].join("\n");
  }

  function init(host) {
    if (host.getAttribute("data-eph-ready")) return;
    host.setAttribute("data-eph-ready", "1");

    var level = parseInt(host.getAttribute("data-heading-level"), 10);
    if (!(level >= 1 && level <= 5)) level = 2;

    var root = host.attachShadow({ mode: "open" });
    var style = document.createElement("style");
    style.textContent = CSS;
    root.appendChild(style);
    var shell = document.createElement("div");
    shell.innerHTML = html(level);
    root.appendChild(shell.firstElementChild);

    var w = root.querySelector(".w");
    var $ = function (id) { return root.getElementById(id); };
    var typeSel = $("type"), numIn = $("num"), reserveCb = $("reserve");
    var randIndex = 0, announceTimer = null;
    var existing = { ids: {}, numbers: {}, max: 0, count: 0 };

    // Theme: light (default), dark, or auto (the viewer's device or explicit page theme)
    var themePref = (host.getAttribute("data-theme") || "light").toLowerCase();
    var mq = window.matchMedia ? window.matchMedia("(prefers-color-scheme: dark)") : null;
    function applyTheme() {
      var mode = "light";
      if (themePref === "dark") mode = "dark";
      else if (themePref === "auto") {
        var explicit = document.documentElement.getAttribute("data-theme");
        mode = explicit === "dark" || explicit === "light" ? explicit : (mq && mq.matches ? "dark" : "light");
      }
      w.setAttribute("data-mode", mode);
    }
    applyTheme();
    if (mq && themePref === "auto") {
      if (mq.addEventListener) mq.addEventListener("change", applyTheme);
      else if (mq.addListener) mq.addListener(applyTheme);
    }

    function pad(n) { var s = String(n); while (s.length < NUM_WIDTH) s = "0" + s; return s; }
    function byCode(code) { for (var i = 0; i < FAMILIES.length; i++) if (FAMILIES[i].code === code) return FAMILIES[i]; return null; }
    function mode() { return root.querySelector("input[name='mode']:checked").value; }
    function wordFor(f, n) { return mode() === "random" ? f.words[randIndex % f.words.length] : f.words[(n - 1) % f.words.length]; }
    function parseNum() {
      var raw = numIn.value.replace(/^\s+|\s+$/g, "");
      if (!/^\d{1,5}$/.test(raw)) return null;
      var n = parseInt(raw, 10);
      return n >= 1 && n <= 99999 ? n : null;
    }
    function currentId() {
      var f = byCode(typeSel.value), n = parseNum();
      return f && n !== null ? f.code + "-" + pad(n) + "-" + wordFor(f, n) : "";
    }

    function announce(text) {
      clearTimeout(announceTimer);
      announceTimer = setTimeout(function () { $("announce").textContent = text; }, 500);
    }

    function fillTypes() {
      var keep = typeSel.value;
      typeSel.innerHTML = "";
      FAMILIES.forEach(function (f) {
        if (!f.active && !reserveCb.checked) return;
        var o = document.createElement("option");
        o.value = f.code;
        o.textContent = f.name + " (" + f.code + ", " + f.sound + ")" + (f.active ? "" : " - reserve");
        typeSel.appendChild(o);
      });
      for (var i = 0; i < typeSel.options.length; i++) if (typeSel.options[i].value === keep) typeSel.value = keep;
    }

    function fillReference() {
      var ul = $("ref");
      FAMILIES.forEach(function (f) {
        var li = document.createElement("li");
        var head = document.createElement("span"); head.className = "head";
        var nm = document.createElement("span"); nm.textContent = f.name;
        var pill = document.createElement("span"); pill.className = "pill" + (f.active ? " on" : ""); pill.textContent = f.active ? "In use" : "Reserve";
        head.appendChild(nm); head.appendChild(pill);
        var meta = document.createElement("span"); meta.className = "meta mono"; meta.textContent = "Code " + f.code + " · sound " + f.sound;
        var words = document.createElement("span"); words.className = "words mono"; words.textContent = f.words.join(", ");
        li.appendChild(head); li.appendChild(meta); li.appendChild(words);
        ul.appendChild(li);
      });
    }

    function render(quiet) {
      var f = byCode(typeSel.value), n = parseNum();
      var out = $("idOut"), err = $("error"), dupe = $("dupe");
      $("shuffle").hidden = mode() !== "random";
      $("status").textContent = "";
      if (!f || n === null) {
        out.textContent = "";
        $("meaning").textContent = "";
        err.hidden = false;
        numIn.setAttribute("aria-invalid", "true");
        numIn.setAttribute("aria-describedby", "num-hint error");
        $("copy").disabled = true;
        dupe.hidden = true;
        return;
      }
      err.hidden = true;
      numIn.removeAttribute("aria-invalid");
      numIn.setAttribute("aria-describedby", "num-hint");
      $("copy").disabled = false;
      var word = wordFor(f, n);
      out.innerHTML = "";
      [["type", f.code], ["", "-"], ["", pad(n)], ["", "-"], ["word", word]].forEach(function (p) {
        var s = document.createElement("span");
        if (p[0]) s.className = p[0];
        s.textContent = p[1];
        out.appendChild(s);
      });
      $("meaning").textContent = f.name + " · " + f.sound + " family" + (f.active ? "" : " · reserve type");
      var id = f.code + "-" + pad(n) + "-" + word;
      if (existing.numbers[n]) {
        dupe.hidden = false;
        dupe.textContent = "Number " + pad(n) + " is already used in the spreadsheet. The next free number is " + pad(existing.max + 1) + ".";
      } else if (existing.ids[id]) {
        dupe.hidden = false;
        dupe.textContent = id + " is already in the spreadsheet.";
      } else {
        dupe.hidden = true;
      }
      if (!quiet) announce("ID is " + id);
    }

    function addRecent(id) {
      $("recentEmpty").hidden = true;
      var ul = $("recent");
      var li = document.createElement("li");
      var t = document.createElement("span"); t.className = "mono"; t.textContent = id;
      var b = document.createElement("button"); b.type = "button"; b.className = "small"; b.textContent = "Copy";
      b.setAttribute("aria-label", "Copy " + id);
      b.addEventListener("click", function () { copyText(id, "Copied " + id); });
      li.appendChild(t); li.appendChild(b);
      ul.insertBefore(li, ul.firstChild);
      while (ul.children.length > 15) ul.removeChild(ul.lastChild);
    }

    function copyText(text, okMsg) {
      var done = function () { $("status").textContent = okMsg; };
      var fallback = function () {
        var ta = document.createElement("textarea");
        ta.value = text; ta.setAttribute("readonly", ""); ta.setAttribute("aria-hidden", "true"); ta.tabIndex = -1;
        ta.style.cssText = "position:fixed;opacity:0;left:0;top:0;width:1px;height:1px;min-height:0;padding:0;border:0";
        w.appendChild(ta);
        ta.select();
        var ok = false;
        try { ok = document.execCommand("copy"); } catch (e) { ok = false; }
        w.removeChild(ta);
        if (ok) done(); else $("status").textContent = "Copy was blocked. Select the ID above and copy it by hand.";
      };
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, fallback);
      else fallback();
    }

    $("copy").addEventListener("click", function () {
      var id = currentId();
      if (!id) return;
      copyText(id, "Copied " + id);
      addRecent(id);
    });
    $("shuffle").addEventListener("click", function () {
      var f = byCode(typeSel.value); if (!f) return;
      var next;
      do { next = Math.floor(Math.random() * f.words.length); } while (f.words.length > 1 && next === randIndex % f.words.length);
      randIndex = next;
      render();
    });
    $("next").addEventListener("click", function () {
      var n = parseNum();
      numIn.value = (n === null ? 0 : n) + 1;
      randIndex = Math.floor(Math.random() * 6);
      render();
    });
    typeSel.addEventListener("change", function () { randIndex = Math.floor(Math.random() * 6); render(); });
    numIn.addEventListener("input", function () { render(); });
    reserveCb.addEventListener("change", function () { fillTypes(); render(); });
    Array.prototype.forEach.call(root.querySelectorAll("input[name='mode']"), function (r) { r.addEventListener("change", function () { render(); }); });

    function parseExisting() {
      var text = $("existing").value.toUpperCase();
      var found = text.match(/\b[A-Z]{2}-\d{1,5}-[A-Z]+\b/g) || [];
      existing = { ids: {}, numbers: {}, max: 0, count: 0 };
      found.forEach(function (m) {
        if (!existing.ids[m]) existing.count++;
        existing.ids[m] = true;
        var n = parseInt(m.split("-")[1], 10);
        existing.numbers[n] = true;
        if (n > existing.max) existing.max = n;
      });
      var out = $("checkOut"), btn = $("useNext");
      if (!existing.count) {
        out.textContent = text.replace(/\s+/g, "") ? "No IDs in the form TYPE-NUMBER-WORD were found." : "";
        btn.disabled = true;
      } else {
        out.textContent = existing.count + (existing.count === 1 ? " ID" : " IDs") + " found. Highest number: " + pad(existing.max) + ". Next free number: " + pad(existing.max + 1) + ".";
        btn.disabled = false;
      }
      render(true);
    }
    $("existing").addEventListener("input", parseExisting);
    $("useNext").addEventListener("click", function () {
      numIn.value = existing.max + 1;
      render();
      $("status").textContent = "Number set to " + pad(existing.max + 1) + ".";
    });

    fillTypes();
    fillReference();
    render(true);
  }

  function boot() {
    var hosts = document.querySelectorAll("[data-ephemera-id-generator]");
    for (var i = 0; i < hosts.length; i++) init(hosts[i]);
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
  else boot();
})();
</script>

</body></html>
