<style>
/* ==========================================================
   CLARK COMICS & GRAPHIC NOVELS EPHEMERA — STAFF PAGES
   Shared styles; scoped; minimum text size 16px
   ========================================================== */

.ephemera-page {
  --ep-ink: #20212a;
  --ep-paper: #fffdf5;
  --ep-yellow: #ffdc52;
  --ep-pink: #ff8eaa;
  --ep-blue: #8ed8ee;
  --ep-green: #b9e6a2;
  --ep-orange: #ffad70;
  --ep-muted: #55545b;

  color: var(--ep-ink);
  background: var(--ep-paper);
  font-family: inherit;
  font-size: 16px;
  line-height: 1.55;
  max-width: 1100px;
  margin: 0 auto;
}

.ephemera-page *,
.ephemera-page *::before,
.ephemera-page *::after {
  box-sizing: border-box;
}

.ephemera-page p,
.ephemera-page li,
.ephemera-page td,
.ephemera-page th {
  font-size: 16px;
}

.ephemera-page p { margin: 0 0 1em; }
.ephemera-page p:last-child { margin-bottom: 0; }

.ephemera-page a {
  color: #174f77;
  text-decoration: underline;
  text-decoration-thickness: 2px;
  text-underline-offset: 3px;
}

.ephemera-page a:hover { color: #8a214b; }

.ephemera-page a:focus-visible,
.ephemera-page button:focus-visible {
  outline: 3px solid #174f77;
  outline-offset: 4px;
  border-radius: 3px;
}

.ephemera-page h2,
.ephemera-page h3,
.ephemera-page h4 {
  color: var(--ep-ink);
  line-height: 1.2;
  font-weight: 900;
}

.ephemera-page h2 {
  font-size: clamp(1.5rem, 3vw, 2rem);
  margin: 0 0 .65em;
}

.ephemera-page h3 {
  font-size: 1.2rem;
  margin: 0 0 .45em;
}

.ephemera-page h4 {
  font-size: 1.05rem;
  margin: 0 0 .4em;
}

.ephemera-page .ep-hero {
  position: relative;
  overflow: hidden;
  padding: clamp(24px, 5vw, 42px);
  margin: 0 0 26px;
  border: 3px solid var(--ep-ink);
  border-radius: 18px;
  background-color: var(--ep-yellow);
  background-image: radial-gradient(
    circle, rgba(32,33,42,.13) 1.2px, transparent 1.5px
  );
  background-size: 13px 13px;
  box-shadow: 6px 6px 0 var(--ep-ink);
}

.ephemera-page .ep-hero h1 {
  max-width: 800px;
  font-size: clamp(2rem, 5vw, 3.1rem);
  line-height: 1.04;
  letter-spacing: -.035em;
  margin: 0 0 13px;
}

.ephemera-page .ep-hero h2 {
  max-width: 800px;
  font-size: clamp(2rem, 5vw, 3.1rem);
  line-height: 1.04;
  letter-spacing: -.035em;
  margin-bottom: 13px;
}

.ephemera-page .ep-card h3 {
  color: var(--ep-ink);
  font-size: 1.35rem !important;
  line-height: 1.2;
  font-weight: 900;
  margin: 0 0 .55em;
}

.ephemera-page .ep-hero p {
  max-width: 780px;
  font-size: 18px;
  font-weight: 600;
}

.ephemera-page .ep-kicker,
.ephemera-page .ep-tag {
  display: inline-block;
  padding: 5px 11px;
  margin-bottom: 12px;
  border: 2px solid var(--ep-ink);
  border-radius: 5px;
  background: var(--ep-paper);
  font-size: 16px;
  font-weight: 900;
  letter-spacing: .04em;
}

.ephemera-page .ep-section { margin: 30px 0; }

.ephemera-page .ep-panel,
.ephemera-page .ep-card {
  padding: 20px;
  border: 2px solid var(--ep-ink);
  border-radius: 13px;
  background: #fff;
  box-shadow: 3px 3px 0 var(--ep-ink);
}

.ephemera-page .ep-panel p:last-child,
.ephemera-page .ep-card p:last-child { margin-bottom: 0; }

.ephemera-page .ep-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.ephemera-page .ep-grid-three {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.ephemera-page .ep-card:nth-child(4n+1) { background: #fff4bd; }
.ephemera-page .ep-card:nth-child(4n+2) { background: #e5f5fc; }
.ephemera-page .ep-card:nth-child(4n+3) { background: #fce5ec; }
.ephemera-page .ep-card:nth-child(4n+4) { background: #eaf5df; }

.ephemera-page .ep-number {
  display: inline-grid;
  place-items: center;
  min-width: 36px;
  height: 36px;
  padding: 0 8px;
  margin-bottom: 10px;
  border: 2px solid var(--ep-ink);
  border-radius: 8px;
  background: var(--ep-yellow);
  font-weight: 900;
}

.ephemera-page .ep-callout {
  padding: 20px;
  margin: 18px 0;
  border: 3px solid var(--ep-ink);
  border-radius: 13px;
  background: var(--ep-green);
  box-shadow: 4px 4px 0 var(--ep-ink);
}

.ephemera-page .ep-warning {
  padding: 20px;
  margin: 18px 0;
  border: 3px solid var(--ep-ink);
  border-radius: 13px;
  background: #ffe3b8;
  box-shadow: 4px 4px 0 var(--ep-ink);
}

.ephemera-page .ep-example {
  padding: 16px;
  margin: 14px 0;
  border-left: 6px solid var(--ep-blue);
  border-radius: 5px;
  background: #eaf7fb;
}

.ephemera-page .ep-example strong,
.ephemera-page .ep-callout strong,
.ephemera-page .ep-warning strong { font-weight: 900; }

.ephemera-page .ep-step {
  padding: 17px;
  border: 2px solid var(--ep-ink);
  border-radius: 11px;
  background: #fff;
}

.ephemera-page .ep-step strong {
  display: block;
  margin-bottom: 5px;
}

.ephemera-page .ep-table-wrap {
  width: 100%;
  overflow-x: auto;
  margin: 16px 0 22px;
  border: 2px solid var(--ep-ink);
  border-radius: 10px;
  background: #fff;
}

.ephemera-page table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.ephemera-page th,
.ephemera-page td {
  padding: 12px 14px;
  border-bottom: 1px solid #d5d3cd;
  vertical-align: top;
}

.ephemera-page th {
  background: var(--ep-yellow);
  color: var(--ep-ink);
  font-weight: 900;
}

.ephemera-page tr:last-child td { border-bottom: 0; }

.ephemera-page .ep-links {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 16px;
}

.ephemera-page .ep-link {
  display: block;
  padding: 15px;
  border: 2px solid var(--ep-ink);
  border-radius: 10px;
  background: #fff;
  color: var(--ep-ink);
  text-decoration: none;
  box-shadow: 2px 2px 0 var(--ep-ink);
}

.ephemera-page .ep-link:hover {
  background: var(--ep-yellow);
  color: var(--ep-ink);
  text-decoration: underline;
}

.ephemera-page .ep-link strong {
  display: block;
  margin-bottom: 4px;
  font-size: 17px;
}

.ephemera-page .ep-link span {
  display: block;
  color: var(--ep-muted);
  font-size: 16px;
}

.ephemera-page .ep-footer {
  padding: 16px 0 8px;
  margin-top: 32px;
  border-top: 2px dashed var(--ep-ink);
  color: var(--ep-muted);
  font-size: 16px;
}

.ephemera-page .ep-small-note {
  color: var(--ep-muted);
  font-size: 16px;
}

.ephemera-page .ep-inline-code {
  display: inline-block;
  padding: 2px 7px;
  border: 1px solid #777;
  border-radius: 4px;
  background: #f0eee8;
  font-family: monospace;
  font-size: 16px;
  font-weight: 700;
}

@media (max-width: 700px) {
  .ephemera-page .ep-grid,
  .ephemera-page .ep-grid-three,
  .ephemera-page .ep-links {
    grid-template-columns: 1fr;
  }

  .ephemera-page .ep-hero { padding: 22px; }

  .ephemera-page th,
  .ephemera-page td {
    padding: 10px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ephemera-page *,
  .ephemera-page *::before,
  .ephemera-page *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }
}
</style>


<div class="ephemera-page">

  <header class="ep-hero">
    <p class="ep-kicker">Comics &amp; Graphic Novels Ephemera</p>
    <h1>Inventory Spreadsheet Guide</h1>
    <p>Use the inventory to search, review, and maintain records for the ephemera collection. Submit new items through the Intake Form rather than entering records directly into the spreadsheet.</p>
  </header>

  <main id="main-content">

    <section class="ep-section" aria-labelledby="sec-workflow">
      <h2 id="sec-workflow">One item. One record.</h2>
      <div class="ep-panel">
        <p>Each distinct physical item requires its own inventory record and unique ID. The <strong>Intake Form</strong> is the data-entry tool; the <strong>inventory spreadsheet</strong> is the searchable record of the collection.</p>
      </div>

      <div class="ep-grid" style="margin-top: 16px;">
        <div class="ep-step">
          <span class="ep-number" aria-hidden="true">1</span>
          <strong>Generate a Unique ID</strong>
          <p>Use the Ephemera ID Generator to create the item's unique identifier before filling out the form.</p>
        </div>

        <div class="ep-step">
          <span class="ep-number" aria-hidden="true">2</span>
          <strong>Submit One Intake Response</strong>
          <p>Complete one Intake Form submission per distinct physical item.</p>
        </div>

        <div class="ep-step">
          <span class="ep-number" aria-hidden="true">3</span>
          <strong>Avoid Direct Spreadsheet Entry</strong>
          <p>Never create duplicate records by typing new items directly into the spreadsheet.</p>
        </div>

        <div class="ep-step">
          <span class="ep-number" aria-hidden="true">4</span>
          <strong>Retire IDs Permanently</strong>
          <p>Never reuse or reassign an ID, even if an item is later withdrawn from the collection.</p>
        </div>
      </div>
    </section>

    <section class="ep-section" aria-labelledby="sec-fields">
      <h2 id="sec-fields">Inventory fields</h2>
      <p>The inventory tracks eight standardized fields for every item in the collection:</p>

      <div class="ep-grid">

        <div class="ep-card">
          <h3>Unique Item ID</h3>
          <p>The complete identifier generated by the Ephemera ID Generator, including the type code, running number, and word component. Each item must have its own unique ID.</p>
        </div>

        <div class="ep-card">
          <h3>Text / Title</h3>
          <p>The printed title or most useful visible wording, transcribed exactly as it appears. Do not correct spelling or silently rewrite text.</p>
          <div class="ep-example">
            <strong>Untitled items:</strong> Enter a brief description in square brackets, such as <code class="ep-inline-code">[Untitled zine fest flyer]</code>.
          </div>
        </div>

        <div class="ep-card">
          <h3>Standardized Item Type</h3>
          <p>Select one of the seven active types: <code class="ep-inline-code">Sticker</code>, <code class="ep-inline-code">Postcard</code>, <code class="ep-inline-code">Poster</code>, <code class="ep-inline-code">Minicomic</code>, <code class="ep-inline-code">Button/pin</code>, <code class="ep-inline-code">Flyer</code>, or <code class="ep-inline-code">Other</code>. Do not invent new type labels.</p>
        </div>

        <div class="ep-card">
          <h3>Size (Inches, Height &times; Width)</h3>
          <p>Record the size selected in the Intake Form in inches, with <strong>height first</strong> and <strong>width second</strong>, based on normal viewing orientation.</p>
          <p>Choose the closest standard size on the form. If none fits, select <strong>Other</strong> and enter exact dimensions (for example, <code class="ep-inline-code">5 x 7</code>). Do not estimate or substitute categories based on item type.</p>
        </div>

        <div class="ep-card">
          <h3>Creator / Organization</h3>
          <p>The artist, creator, publisher, bookstore, organization, or event identified on the item or in donor notes. Leave blank if unknown; do not guess.</p>
        </div>

        <div class="ep-card">
          <h3>Keywords</h3>
          <p>Enter 3&ndash;6 practical search terms separated by semicolons, describing subjects, formats, creators, locations, characters, or organizations.</p>
          <div class="ep-example">
            <strong>Example:</strong> <code class="ep-inline-code">comics; Portland; independent publishing; bookstore</code>
          </div>
        </div>

        <div class="ep-card">
          <h3>Physical Storage Location</h3>
          <p>Record the item's exact final housing location using the standard format:</p>
          <ul>
            <li>Binder: <code class="ep-inline-code">Binder 2, p. 14</code></li>
            <li>Flat file: <code class="ep-inline-code">Flat File, Drawer 1</code></li>
          </ul>
          <p>If an item moves, update its existing location cell. Do not generate a new ID or submit a new intake record.</p>
        </div>

        <div class="ep-card">
          <h3>Donor / Source and Date Received</h3>
          <p>Record the donor or source name followed by the ISO date received: <code class="ep-inline-code">Jane Doe, 2026-11-16</code> or <code class="ep-inline-code">Unknown, 2026-11-16</code>.</p>
          <p>Keep confidential notes, restrictions, or handling preferences out of this field. File paperwork in the donor folder and consult the librarian.</p>
        </div>

      </div>
    </section>

    <section class="ep-section" aria-labelledby="sec-searching">
      <h2 id="sec-searching">Recording and searching the inventory</h2>
      <div class="ep-panel">
        <ul>
          <li><strong>Search first:</strong> Use the spreadsheet's search or filter tools to check by ID, title, type, creator, keyword, size, or location before assuming an item is uncataloged.</li>
          <li><strong>Stick to controlled values:</strong> Use the standardized item type and size values so records stay consistent and filterable.</li>
          <li><strong>Verify physical matches:</strong> When reviewing a record, confirm that the ID and storage location match the physical item.</li>
          <li><strong>Update in place:</strong> For a moved item, edit the existing location field rather than creating a second row.</li>
        </ul>
      </div>

      <div class="ep-table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Action</th>
              <th scope="col">Where to Do It</th>
              <th scope="col">Rule to Remember</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Add a new item</strong></td>
              <td>Intake Form</td>
              <td>Generate a unique ID first; submit one form per item.</td>
            </tr>
            <tr>
              <td><strong>Update a storage location</strong></td>
              <td>Inventory Spreadsheet</td>
              <td>Edit the existing record; never issue a new ID.</td>
            </tr>
            <tr>
              <td><strong>Log donor restrictions</strong></td>
              <td>Donor Folder</td>
              <td>Keep confidential notes out of the public/staff spreadsheet.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="ep-section" aria-labelledby="sec-mistakes">
      <div class="ep-warning">
        <h2 id="sec-mistakes">Common mistakes to avoid</h2>
        <ul>
          <li>Creating more than one record for the same physical item.</li>
          <li>Reusing an ID or changing an item's existing ID.</li>
          <li>Entering a custom item type instead of one of the seven standardized types.</li>
          <li>Mixing up height and width or recording dimensions in centimeters instead of inches.</li>
          <li>Guessing at a creator, title, date, or other unknown detail.</li>
          <li>Putting donor restrictions or confidential notes in the general inventory.</li>
          <li>Writing directly on an item rather than labeling its sleeve or housing.</li>
        </ul>
      </div>
    </section>

    <section class="ep-section" aria-labelledby="sec-consult">
      <div class="ep-callout">
        <h2 id="sec-consult">When to consult the librarian</h2>
        <p><strong>Pause routine processing and consult the librarian</strong> if an item is damaged, fragile, contains sensitive material, has donor restrictions or special handling preferences, or presents an unusual cataloging or storage question.</p>
      </div>
    </section>

  </main>

  <footer class="ep-footer">
    Clark College Libraries &middot; Comics &amp; Graphic Novels Ephemera &middot; Inventory reference
  </footer>

</div>
