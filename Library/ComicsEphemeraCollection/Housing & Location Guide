  font-size: 16px;
}

.ephemera-page p { margin: 0 0 1em; }
.ephemera-page p:last-child { margin-bottom: 0; }

.ephemera-page a {
  color: #174f77;
  text-decoration: underline;
  text-decoration-thickness: 2px;
  text-underline-offset: 3px;
}

.ephemera-page a:hover { color: #8a214b; }

.ephemera-page a:focus-visible,
.ephemera-page button:focus-visible {
  outline: 3px solid #174f77;
  outline-offset: 4px;
  border-radius: 3px;
}

.ephemera-page h2,
.ephemera-page h3,
.ephemera-page h4 {
  color: var(--ep-ink);
  line-height: 1.2;
  font-weight: 900;
}

.ephemera-page h2 {
  font-size: clamp(1.5rem, 3vw, 2rem);
  margin: 0 0 .65em;
}

.ephemera-page h3 {
  font-size: 1.2rem;
  margin: 0 0 .45em;
}

.ephemera-page h4 {
  font-size: 1.05rem;
  margin: 0 0 .4em;
}

.ephemera-page .ep-hero {
  position: relative;
  overflow: hidden;
  padding: clamp(24px, 5vw, 42px);
  margin: 0 0 26px;
  border: 3px solid var(--ep-ink);
  border-radius: 18px;
  background-color: var(--ep-yellow);
  background-image: radial-gradient(
    circle, rgba(32,33,42,.13) 1.2px, transparent 1.5px
  );
  background-size: 13px 13px;
  box-shadow: 6px 6px 0 var(--ep-ink);
}

.ephemera-page .ep-hero h2 {
  max-width: 800px;
  font-size: clamp(2rem, 5vw, 3.1rem);
  line-height: 1.04;
