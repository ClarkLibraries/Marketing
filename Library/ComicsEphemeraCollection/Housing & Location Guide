.ephemera-page .ep-number {
  display: inline-grid;
  place-items: center;
  min-width: 36px;
  height: 36px;
  padding: 0 8px;
  margin-bottom: 10px;
  border: 2px solid var(--ep-ink);
  border-radius: 8px;
  background: var(--ep-yellow);
  font-weight: 900;
}

.ephemera-page .ep-callout {
  padding: 20px;
  margin: 18px 0;
  border: 3px solid var(--ep-ink);
  border-radius: 13px;
  background: var(--ep-green);
  box-shadow: 4px 4px 0 var(--ep-ink);
}

.ephemera-page .ep-warning {
  padding: 20px;
  margin: 18px 0;
  border: 3px solid var(--ep-ink);
  border-radius: 13px;
  background: #ffe3b8;
  box-shadow: 4px 4px 0 var(--ep-ink);
}

.ephemera-page .ep-example {
  padding: 16px;
  margin: 14px 0;
  border-left: 6px solid var(--ep-blue);
  border-radius: 5px;
  background: #eaf7fb;
}

.ephemera-page .ep-example strong,
.ephemera-page .ep-callout strong,
.ephemera-page .ep-warning strong { font-weight: 900; }

.ephemera-page .ep-step {
  padding: 17px;
  border: 2px solid var(--ep-ink);
  border-radius: 11px;
  background: #fff;
}

.ephemera-page .ep-step strong {
  display: block;
  margin-bottom: 5px;
}

.ephemera-page .ep-table-wrap {
  width: 100%;
  overflow-x: auto;
  margin: 16px 0 22px;
  border: 2px solid var(--ep-ink);
  border-radius: 10px;
  background: #fff;
}

.ephemera-page table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.ephemera-page th,
.ephemera-page td {
  padding: 12px 14px;
  border-bottom: 1px solid #d5d3cd;
  vertical-align: top;
}

.ephemera-page th {
  background: var(--ep-yellow);
  color: var(--ep-ink);
  font-weight: 900;
}

.ephemera-page tr:last-child td { border-bottom: 0; }

.ephemera-page .ep-links {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 16px;
}

.ephemera-page .ep-link {
  display: block;
  padding: 15px;
  border: 2px solid var(--ep-ink);
  border-radius: 10px;
  background: #fff;
  color: var(--ep-ink);
  text-decoration: none;
  box-shadow: 2px 2px 0 var(--ep-ink);
}

.ephemera-page .ep-link:hover {
  background: var(--ep-yellow);
  color: var(--ep-ink);
  text-decoration: underline;
