.ephemera-page .ep-hero p {
  max-width: 780px;
  font-size: 18px;
  font-weight: 600;
}

.ephemera-page .ep-kicker,
.ephemera-page .ep-tag {
  display: inline-block;
  padding: 5px 11px;
  margin-bottom: 12px;
  border: 2px solid var(--ep-ink);
  border-radius: 5px;
