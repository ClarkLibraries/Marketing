<style>
/* ==========================================================
   CLARK COMICS & GRAPHIC NOVELS EPHEMERA — STAFF PAGES
   Shared styles; scoped; minimum text size 16px
   ========================================================== */

.ephemera-page {
  --ep-ink: #20212a;
  --ep-paper: #fffdf5;
  --ep-yellow: #ffdc52;
  --ep-pink: #ff8eaa;
  --ep-blue: #8ed8ee;
  --ep-green: #b9e6a2;
  --ep-orange: #ffad70;
  --ep-muted: #55545b;

  color: var(--ep-ink);
  background: var(--ep-paper);
  font-family: inherit;
  font-size: 16px;
  line-height: 1.55;
  max-width: 1100px;
  margin: 0 auto;
}

.ephemera-page *,
.ephemera-page *::before,
.ephemera-page *::after {
  box-sizing: border-box;
}

.ephemera-page p,
.ephemera-page li,
.ephemera-page td,
