});
$('#advId').addEventListener('input', e => { st.advId = e.target.value; save(); });
$('#advId').addEventListener('change', e => { st.advId = cleanId(e.target.value); e.target.value = st.advId; save(); });
$$('#colors input').forEach(r => r.addEventListener('change', () => { st.color = r.value; save(); }));

/* ---- step 1: "Learn more" links ---- */
function renderLinks() {
  $('#linkList').innerHTML = st.links.map((l, i) => `<div class="lrow">` +
    `<div class="f"><label for="lk-l-${l._id}">Link ${i + 1} button text</label><input type="text" id="lk-l-${l._id}" data-lk="label" value="${esc(l.label)}" autocomplete="off"></div>` +
    `<div class="f"><label for="lk-u-${l._id}">Link ${i + 1} web address</label><input type="text" id="lk-u-${l._id}" data-lk="url" value="${esc(l.url)}" inputmode="url" autocomplete="off" aria-describedby="lk-e-${l._id}"><span class="err" id="lk-e-${l._id}"></span></div>` +
    `<div><button type="button" class="btn sm" data-rm="${l._id}">Remove<span class="sr"> link ${i + 1}</span></button></div></div>`).join('') || '<p class="hint">No links yet. Select <b>Add a link</b>.</p>';
  $$('#linkList input[data-lk=url]').forEach(linkErr);
}
function linkErr(inp) {
  const v = inp.value.trim(), bad = v && !isUrl(v);
  inp.setAttribute('aria-invalid', bad ? 'true' : 'false');
  const err = $('#' + inp.id.replace('lk-u-', 'lk-e-')); if (err) err.textContent = bad ? 'A web address must start with https:// and have no spaces.' : '';
}
$('#linkList').addEventListener('input', e => {
  const row = e.target.closest('.lrow'), k = e.target.dataset.lk; if (!row || !k) return;
  const id = e.target.id.replace(/^lk-[lu]-/, ''), l = st.links.find(x => x._id === id); if (!l) return;
  l[k] = e.target.value; if (k === 'url') linkErr(e.target); save();
});
$('#linkList').addEventListener('click', e => {
  const b = e.target.closest('[data-rm]'); if (!b) return;
  st.links = st.links.filter(l => l._id !== b.dataset.rm); renderLinks(); save(); $('#addLink').focus();
});
$('#addLink').addEventListener('click', () => {
  const l = { _id: nid(), label: '', url: '' }; st.links.push(l); renderLinks(); save();
  const inp = $('#lk-l-' + l._id); if (inp) inp.focus();
});

/* ---- step 2: fields ---- */
function renderFieldChecks() {
  $('#fieldChecks').innerHTML = FIELDS.map(f => `<label class="chk"><input type="checkbox" data-f="${f.k}"${st.fields[f.k] ? ' checked' : ''}><span><b>${f.l}</b></span></label>`).join('');
}
$('#fieldChecks').addEventListener('change', e => { const k = e.target.dataset.f; if (k) { st.fields[k] = e.target.checked; renderEditor(); updateExport(); save(); } });
$$('input[name=m]').forEach(r => r.addEventListener('change', () => { $('#mType').hidden = r.value !== 'type' || !r.checked; $('#mPaste').hidden = r.value !== 'paste' || !r.checked; }));

/* ---- step 2: help for pasting a list ---- */
(function () {
  const h = $('#pasteHelp'), url = isUrl(HELP_URL) ? HELP_URL : '', who = String(HELP_CONTACT || '').trim();
  if (!url && !who) { h.hidden = true; return; }
  h.append('Not sure how to make a list? ');
  if (url) { const a = document.createElement('a'); a.href = url; a.target = '_blank'; a.rel = 'noopener noreferrer'; a.textContent = 'Read the how-to guide'; h.append(a, ' (opens in a new tab). '); }
  if (who) h.append('For help, contact ' + who + '.');
})();

/* ---- step 2: type them in ---- */
const label = it => (String(it.title || '').trim() || '(no title yet)') + (it._ex ? ' (example)' : '');
const cur = () => st.items.find(i => i._id === st.sel);
function renderTList() {
  $('#countH').textContent = `Your titles (${st.items.length})`;
  $('#bigNote').hidden = st.items.length < BIG_NOTE;
  $('#tlist').innerHTML = st.items.map(it => `<li><button type="button" data-sel="${it._id}"${it._id === st.sel ? ' aria-current="true"' : ''}>${esc(label(it))}</button></li>`).join('') || '<li class="hint" style="padding:8px">No titles yet.</li>';
  $('#sampleNote').hidden = !st.items.some(i => i._ex);
}
$('#tlist').addEventListener('click', e => { const b = e.target.closest('[data-sel]'); if (b) { st.sel = b.dataset.sel; renderTList(); renderEditor(); } });
function renderEditor() {
  const it = cur(), box = $('#editor');
  if (!it) { box.innerHTML = '<p class="hint">Select <b>Add a title</b> to start.</p>'; return; }
  const row = (k, l, h, isUrlField) => `<div class="f"><label for="ed-${k}">${l}</label>${h ? `<span class="hint" id="ed-${k}-h">${h}</span>` : ''}<input type="text" id="ed-${k}" data-k="${k}" value="${esc(it[k])}" autocomplete="off"${isUrlField ? ' inputmode="url"' : ''} aria-describedby="${h ? `ed-${k}-h ` : ''}ed-${k}-e"><span class="err" id="ed-${k}-e"></span></div>`;
  box.innerHTML = row('title', 'Title (required)', '', false) +
    FIELDS.filter(f => st.fields[f.k]).map(f => row(f.k, f.l, f.h, f.g === 'url')).join('') +
    `<div class="row"><button type="button" class="btn sm" id="delTitle">Delete this title</button></div>`;
  $$('#editor input').forEach(i => fieldCheck(i));
}
function fieldCheck(inp) {
  const k = inp.dataset.k, v = inp.value.trim(), f = FIELDS.find(x => x.k === k);
  let m = '';
  if (k === 'title' && !v) m = 'Every title needs a name.';
  else if (f && f.g === 'url' && v && !isUrl(v)) m = 'A web address must start with https:// and have no spaces.';
  inp.setAttribute('aria-invalid', m ? 'true' : 'false'); $('#' + inp.id.replace(/$/, '-e')).textContent = m;
}
$('#editor').addEventListener('input', e => {
  const it = cur(), k = e.target.dataset.k; if (!it || !k) return;
  it[k] = e.target.value; delete it._ex; fieldCheck(e.target);
  if (k === 'title') { const b = $(`#tlist [data-sel="${it._id}"]`); if (b) b.textContent = label(it); }
  $('#sampleNote').hidden = !st.items.some(i => i._ex); updateExport(); save();
});
$('#editor').addEventListener('click', e => {
  if (e.target.id !== 'delTitle') return;
  armed(e.target, 'Delete this title', () => {
    const i = st.items.findIndex(x => x._id === st.sel); st.items.splice(i, 1);
    st.sel = st.items[Math.min(i, st.items.length - 1)] ? st.items[Math.min(i, st.items.length - 1)]._id : null;
    renderTList(); renderEditor(); updateExport(); save(); $('#addTitle').focus();
  });
});
$('#addTitle').addEventListener('click', () => {
  const it = { _id: nid(), title: '' }; st.items.push(it); st.sel = it._id; renderTList(); renderEditor(); updateExport(); save();
  $('#ed-title').focus(); $('#tlist').scrollTop = 1e6;
});
$('#clearSample').addEventListener('click', () => {
  st.items = st.items.filter(i => !i._ex); st.sel = st.items[0] ? st.items[0]._id : null;
  renderTList(); renderEditor(); updateExport(); save(); $('#addTitle').focus();
});

/* ---- step 2: paste a list ---- */
const norm = k => String(k).toLowerCase().replace(/[^a-z0-9]/g, '');
const ALIAS = {
  title: 'title', name: 'title', booktitle: 'title',
  type: 'type', resourcetype: 'type', materialtype: 'type', format: 'type',
  author: 'author', authors: 'author', creator: 'author', publisher: 'publisher',
  year: 'year', date: 'year', publicationyear: 'year', publicationdate: 'year',
  subject: 'subject', subjects: 'subject', location: 'location', callnumber: 'location',
  description: 'description', summary: 'description', abstract: 'description', note: 'description',
  permalink: 'permalink', link: 'permalink', url: 'permalink',
  linklabel: 'linklabel', linktext: 'linklabel', buttontext: 'linklabel',
  coverimage: 'coverimage', cover: 'coverimage', image: 'coverimage', thumbnail: 'coverimage',
  articlesaboutthisresource: 'articlesaboutthisresource', relatedarticles: 'relatedarticles', youmayalsolike: 'youmayalsolike'
};
const val = v => typeof v === 'string' ? v : typeof v === 'number' ? String(v) : Array.isArray(v) ? v.filter(x => typeof x === 'string' || typeof x === 'number').join('; ') : '';
function parseList(text) {
  if (!text.trim()) return { error: 'Paste your list in the box first.' };
  let v; try { v = JSON.parse(text); } catch (e) { const m = /position (\d+)/.exec(e.message); return { error: 'We could not read that list.' + (m ? ` Something looks wrong near character ${m[1]}.` : '') + ' Check for a missing comma, quote or bracket, then try again.' }; }
  if (v && !Array.isArray(v) && typeof v === 'object') v = Object.values(v).find(Array.isArray) || [v];
  if (!Array.isArray(v)) return { error: 'That does not look like a list of titles. It should start with [ and end with ].' };
  const items = [], present = new Set(), ignored = new Set(); let skipped = 0;
  v.forEach(o => {
    if (!o || typeof o !== 'object' || Array.isArray(o)) { skipped++; return; }
    const it = { _id: nid() };
    Object.keys(o).forEach(key => { const m = ALIAS[norm(key)]; if (!m) { ignored.add(key); return; } const x = val(o[key]).trim(); if (x && !it[m]) it[m] = x; });
    if (!it.title) { skipped++; return; }
    Object.keys(it).forEach(k => { if (k !== '_id') present.add(k); });
    items.push(it);
  });
  if (!items.length) return { error: 'We found no titles in that list. Each entry needs a title.' };
  return { items, present, ignored: [...ignored], skipped };
}
function importText(text) {
  const r = parseList(text), msg = $('#pasteMsg');
  msg.className = 'msg ' + (r.error ? 'bad' : 'good');
  if (r.error) { msg.innerHTML = `<b>Nothing was changed.</b><span>${esc(r.error)}</span>`; return; }
  const mode = $('input[name=pm]:checked').value;
  st.items = mode === 'replace' ? r.items : st.items.filter(i => !i._ex).concat(r.items);
  FIELDS.forEach(f => { if (r.present.has(f.k)) st.fields[f.k] = true; else if (mode === 'replace') st.fields[f.k] = false; });
  st.sel = st.items[0]._id;
  const names = FIELDS.filter(f => r.present.has(f.k)).map(f => f.l.replace(/[\u201c\u201d]/g, ''));
  msg.innerHTML = `<b>${mode === 'replace' ? 'Loaded' : 'Added'} ${r.items.length} ${r.items.length === 1 ? 'title' : 'titles'}.</b><span>Details found: ${esc(['Title'].concat(names).join(', '))}.</span>` +
    (r.ignored.length ? `<span>Left out because this display does not use them: ${esc(r.ignored.slice(0, 12).join(', '))}${r.ignored.length > 12 ? ', and more' : ''}.</span>` : '') +
    (r.skipped ? `<span>${r.skipped} ${r.skipped === 1 ? 'entry was' : 'entries were'} skipped because there was no title.</span>` : '') +
    '<span>Next, choose <b>Preview and copy</b>. You can also switch details on or off above.</span>';
  renderFieldChecks(); renderTList(); renderEditor(); updateExport(); save(); msg.focus();
}
$('#pasteGo').addEventListener('click', () => importText($('#pasteText').value));
$('#pasteFile').addEventListener('change', e => {
  const f = e.target.files[0]; if (!f) return;
  const fr = new FileReader(); fr.onload = () => { $('#pasteText').value = String(fr.result); importText(String(fr.result)); }; fr.readAsText(f);
});
function updateExport() { $('#expText').value = JSON.stringify(lgsExport(st).data); }
$('#expCopy').addEventListener('click', async () => {
  const t = $('#expText');
  try { await navigator.clipboard.writeText(t.value); say('#expMsg', 'Copied.'); } catch (e) { t.focus(); t.select(); say('#expMsg', 'Selected. Press Ctrl+C (Cmd+C on a Mac) to copy.'); }
});

/* ---- step 3 ---- */
const host = $('#host'); host.attachShadow({ mode: 'open' });
function problems() {
  const out = [], P = (sev, msg, id, k) => out.push({ sev, msg, id, k });
  if (!st.name.trim()) P('bad', 'Your display needs a name. Go back to step 1.');
  const withTitle = st.items.filter(i => String(i.title || '').trim());
  if (!withTitle.length) P('bad', 'Your list is empty. Add at least one title in step 2.');
  if (withTitle.length > BIG_WARN) P('warn', `This is a long list (${withTitle.length} titles). It works, but it may load slowly on phones. Consider showing fewer details or splitting it into two displays.`);
  if (st.items.some(i => i._ex)) P('warn', 'The example titles are still in your list. Remove them in step 2 if you do not want them to appear.');
  const blank = st.items.length - withTitle.length; if (blank) P('warn', `${blank} ${blank === 1 ? 'entry has' : 'entries have'} no title and will be left out.`);
  withTitle.forEach(it => FIELDS.forEach(f => {
    if (f.g !== 'url' || !st.fields[f.k]) return; const v = String(it[f.k] || '').trim(); if (!v) return;
    if (!isUrl(v)) P('bad', `\u201c${it.title}\u201d: the ${f.l.replace(/[\u201c\u201d]/g, '')} address is not a full web address. It must start with https://`, it._id, f.k);
    else if (f.k === 'coverimage' && /^http:/i.test(v)) P('warn', `\u201c${it.title}\u201d: the cover picture address starts with http://. Use https:// so it shows on secure pages.`, it._id, f.k);
  }));
  if (st.moreOn) {
    const used = st.links.filter(l => String(l.label || '').trim() || String(l.url || '').trim());
    if (!used.length) P('bad', 'The \u201cLearn more\u201d section has no links. Add one in step 1, or turn the section off.');
    used.forEach(l => {
      if (!String(l.label || '').trim()) P('bad', `A \u201cLearn more\u201d link (${l.url.trim()}) needs button text. Fix it in step 1.`);
      else if (!isUrl(String(l.url || '').trim())) P('bad', `The \u201cLearn more\u201d link \u201c${l.label.trim()}\u201d needs a full web address that starts with https:// . Fix it in step 1.`);
    });
  }
  if (st.footerOn && (!st.ftLabel.trim() || !isUrl(st.ftUrl.trim()))) P('bad', 'The \u201cNeed help?\u201d box needs button text and a full web address, or turn it off in step 1.');
  return out;
}
function renderPreview() {
  const x = lgsExport(st), sr = host.shadowRoot;
  sr.innerHTML = '<style>:host{display:block}</style>' + x.css + x.shell;
  lgsInit(sr.querySelector('#' + x.id), x.data, { id: x.id, fields: x.fields });
  host.style.maxWidth = $('input[name=w]:checked').value === '100%' ? '100%' : $('input[name=w]:checked').value + 'px';
  $('#code').value = x.code;
  const kb = Math.round(x.code.length / 1024);
  $('#sizeNote').textContent = `${x.data.length} ${x.data.length === 1 ? 'title' : 'titles'}, about ${kb} KB of code.` + (kb > 800 ? ' That is large. If LibGuides will not save it, show fewer details or split the list into two displays.' : '');
  const ps = problems();
  $('#problems').innerHTML = ps.length ? ps.map((p, i) => `<li><span class="tag ${p.sev}">${p.sev === 'bad' ? 'Fix' : 'Check'}</span><span>${esc(p.msg)}</span>${p.id ? `<button type="button" class="btn sm" data-fix="${i}">Go fix it</button>` : ''}</li>`).join('') : '<li><span class="tag ok">Ready</span><span>No problems found. Your display is ready to copy.</span></li>';
  lastProblems = ps;
}
$$('input[name=w]').forEach(r => r.addEventListener('change', renderPreview));
$('#problems').addEventListener('click', e => {
  const b = e.target.closest('[data-fix]'); if (!b) return; const p = lastProblems[Number(b.dataset.fix)];
  st.sel = p.id; showStep(2, false);
  const r = $('input[name=m][value=type]'); r.checked = true; r.dispatchEvent(new Event('change'));
  renderTList(); renderEditor(); const el = $('#ed-' + p.k); if (el) el.focus();
});
$('#copy').addEventListener('click', async () => {
  const t = $('#code');
  try { await navigator.clipboard.writeText(t.value); say('#copyMsg', 'Copied. Now paste it into your LibGuide.'); }
  catch (e) { $('#codeBox').open = true; t.focus(); t.select(); say('#copyMsg', 'The code is selected below. Press Ctrl+C (Cmd+C on a Mac) to copy it.'); }
});
$$('#reset, #reset1').forEach(b => b.addEventListener('click', e => armed(e.currentTarget, 'Reset/Start over', () => { st = sample(); syncStep1(); showStep(1, true); })));

st = load() || sample();
syncStep1(); showStep(st.step, false);

}
var els = document.querySelectorAll('comics-display-builder');
for (var i = 0; i < els.length; i++) { if (!els[i].shadowRoot) mount(els[i]); }
})();
</script>
